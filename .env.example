# ==========================================
# LOST & FOUND PORTAL - ENVIRONMENT TEMPLATE
# ==========================================

# Server Port (Default is 5000 or assigned by cloud platform like Render/Railway)
PORT=5000

# Node Environment ('development' or 'production')
NODE_ENV=production

# Database Connection (Option 1: Cloud Database URL like Railway/Render/Aiven)
# DATABASE_URL=mysql://root:password@containers.railway.app:3306/railway
# MYSQL_URL=mysql://root:password@containers.railway.app:3306/railway

# Database Connection (Option 2: Individual DB parameters)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=lost_found_db

# Security & Authentication
JWT_SECRET=replace_with_a_long_random_secret_string_here_min_32_chars

# CORS Configuration (* allows all origins, or specify: https://your-app.onrender.com)
CORS_ORIGINS=*

# OTP Expiration in minutes
OTP_EXPIRY_MINUTES=15
